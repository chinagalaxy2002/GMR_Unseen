  "num_queries": 10,
  "n_input_proj": 2,
  "saliency_margin": 0.2,
  "span_loss_type": "l1",
  "set_cost_span": 10,
  "set_cost_giou": 1,
  "set_cost_class": 4,
  "span_loss_coef": 10,
  "giou_loss_coef": 1,
  "label_loss_coef": 4,
  "eos_coef": 0.1,
