{
  "seed": 2023,
  "device": "cuda",
  "num_workers": 4,
  "lr": 0.0001,
  "lr_drop": 200,
  "wd": 0.0001,
  "n_epoch": 200,
  "max_es_cnt": 50,
  "bsz": 16,
  "eval_bsz": 8,
  "grad_clip": 0.1,
